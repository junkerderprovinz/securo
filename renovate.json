{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>junkerderprovinz/junkerderprovinz//renovate/base",
    "local>junkerderprovinz/junkerderprovinz//renovate/components"
  ],
  "packageRules": [
    {
      "description": "Securo upstream: review by hand, each release migrates the database",
      "matchPackageNames": [
        "ghcr.io/securo-finance/securo-backend",
        "ghcr.io/securo-finance/securo-frontend"
      ],
      "groupName": "Securo",
      "commitMessageTopic": "Securo",
      "commitMessagePrefix": "feat:",
      "labels": [
        "upstream-bump"
      ],
      "automerge": false
    }
  ]
}
