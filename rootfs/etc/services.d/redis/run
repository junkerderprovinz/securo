#!/command/with-contenv bash
# shellcheck shell=bash
# The built-in Redis, started only with BUILTIN_REDIS=true. A snapshot keeps the
# Celery queue and the login state of the last few minutes across a restart.

if [ "${BUILTIN_REDIS}" != true ]; then
    s6-svc -O .
    exit 0
fi

exec gosu "${PUID:-99}:${PGID:-100}" redis-server \
    --bind 127.0.0.1 --port 6379 \
    --dir /data/redis --save 300 1 --appendonly no \
    --loglevel warning
