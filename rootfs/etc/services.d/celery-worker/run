#!/command/with-contenv bash
# shellcheck shell=bash
# Runs bank syncs, recurring transactions and price updates. Two processes, as in
# upstream's compose file, to keep the memory down.

until [ -f /run/securo/migrated ]; do sleep 2; done
cd /app || exit 1

exec gosu "${PUID:-99}:${PGID:-100}" env HOME=/tmp/securo \
    celery -A app.worker worker --loglevel=info --concurrency=2
